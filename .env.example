# MongoDB connection string (MongoDB Atlas in production)
MONGODB_URI="mongodb://localhost:27017/quizler"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Canonical URL of the deployment (Vercel sets this automatically in production)
NEXTAUTH_URL="http://localhost:3000"

# Only email addresses at this domain may register. Leave blank to allow any domain.
ALLOWED_EMAIL_DOMAIN="college.edu"

# Used only by scripts/seed.ts
SEED_ADMIN_EMAIL="admin@college.edu"
SEED_ADMIN_PASSWORD=""

# --- Deploying on Vercel ---
# Set MONGODB_URI, AUTH_SECRET and ALLOWED_EMAIL_DOMAIN in Project Settings ->
# Environment Variables for Production, Preview and Development.
# NEXTAUTH_URL should be your production domain (e.g. https://quizler.vercel.app).
# MongoDB Atlas: allow access from Vercel under Network Access (0.0.0.0/0, or use
# the Atlas integration from the Vercel Marketplace).
