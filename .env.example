MONGODB_URI="mongodb+srv://pranaygajbhiye2020_db_user:5KDrET38mkklOF4V@cluster0.t3mdv0w.mongodb.net"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Canonical URL of the deployment (Vercel sets this automatically in production)
NEXTAUTH_URL="http://localhost:3000"

# Only email addresses at this domain may register with credentials. Leave blank
# to allow any domain. Does not apply to Google sign-in (any Google account may sign in).
ALLOWED_EMAIL_DOMAIN="college.edu"

# Used only by scripts/seed.ts
SEED_ADMIN_EMAIL="admin@college.edu"
SEED_ADMIN_PASSWORD=""

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Deploying on Vercel ---
# Set MONGODB_URI, AUTH_SECRET, ALLOWED_EMAIL_DOMAIN, AUTH_GOOGLE_ID and
# AUTH_GOOGLE_SECRET in Project Settings -> Environment Variables for
# Production, Preview and Development.
# NEXTAUTH_URL should be your production domain (e.g. https://quizler.vercel.app).
# MongoDB Atlas: allow access from Vercel under Network Access (0.0.0.0/0, or use
# the Atlas integration from the Vercel Marketplace).
